--cpu Cortex-M3
"pj1\startup_stm32f103xb.o"
"pj1\main.o"
"pj1\gpio.o"
"pj1\usart.o"
"pj1\stm32f1xx_it.o"
"pj1\stm32f1xx_hal_msp.o"
"pj1\stm32f1xx_hal_gpio_ex.o"
"pj1\stm32f1xx_hal_tim.o"
"pj1\stm32f1xx_hal_tim_ex.o"
"pj1\stm32f1xx_hal_uart.o"
"pj1\stm32f1xx_hal.o"
"pj1\stm32f1xx_hal_rcc.o"
"pj1\stm32f1xx_hal_rcc_ex.o"
"pj1\stm32f1xx_hal_gpio.o"
"pj1\stm32f1xx_hal_dma.o"
"pj1\stm32f1xx_hal_cortex.o"
"pj1\stm32f1xx_hal_pwr.o"
"pj1\stm32f1xx_hal_flash.o"
"pj1\stm32f1xx_hal_flash_ex.o"
