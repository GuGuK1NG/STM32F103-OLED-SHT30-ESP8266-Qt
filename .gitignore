# ============================================================
#  STM32 / MDK-ARM (Keil)
# ============================================================

# 编译输出目录（.o / .d / .axf / .hex / .map / .lst 等全在这里，整个目录都不跟踪）
MDK-ARM/PJ1/

# Keil 的用户界面布局文件（每人每台机器都不一样）
*.uvguix.*

# VSCode + Keil Assistant 的日志与自动生成的配置（含本机绝对路径）
MDK-ARM/.vscode/

# 通用编译产物兜底（防止以后改了输出目录又漏掉）
*.o
*.d
*.axf
*.hex
*.bin
*.map
*.lst
*.crf
*.dep
*.lnp
*.build_log.htm
*.scvd

# ============================================================
#  Qt 上位机
# ============================================================

QtServer/*/build/
QtServer/*/*/build/
*.user.*

# ============================================================
#  文档（不随源码公开）
# ============================================================

docs/

# ============================================================
#  敏感配置
# ============================================================
# 若把 WiFi 账号密码 / 服务器地址挪到独立配置文件，取消下一行注释
# BSP/bsp_esp_config.h
